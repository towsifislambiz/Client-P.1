# Link BD ISP — Production Environment Configuration Example
# Copy this file to .env and configure your production credentials

# Server Port
PORT=5100

# Authentication JWT Secret (Generate a strong 64-char crypto secret in production)
AUTH_SECRET=your-super-secure-jwt-auth-secret-key-change-this

# Admin Initial Credentials
ADMIN_EMAIL=admin@linkbd.net
ADMIN_INITIAL_PASSWORD=admin123456

# File Upload Max Size (Bytes) - 5MB default
UPLOAD_MAX_SIZE=5242880

# ----------------------------------------------------
# CYBER SECURITY & DDOS SHIELD CONFIGURATION
# ----------------------------------------------------

# Distributed Redis / Upstash Rate Limiter (Optional - falls back to in-memory if empty)
# Example Upstash: rediss://default:YOUR_PASSWORD@your-cluster.upstash.io:6379
REDIS_URL=

# Reverse Proxy / Cloudflare Client IP Trust (Set to true in production behind Cloudflare/Nginx)
TRUST_PROXY=true

# Rate Limits (Requests per IP per minute / window)
GLOBAL_RATE_LIMIT=200
AUTH_RATE_LIMIT=10
PAYMENT_RATE_LIMIT=15
INQUIRY_RATE_LIMIT=20
ATTACK_MODE_RATE_LIMIT=60

# Quarantine Duration (Seconds an abusive IP is locked out - default 15 minutes)
QUARANTINE_DURATION=900

# Default Attack Mode on Boot ('normal' or 'under_attack')
ATTACK_MODE=normal
